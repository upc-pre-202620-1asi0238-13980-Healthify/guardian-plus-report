digraph ERD {
  graph [rankdir=TB, splines=polyline, nodesep=0.45, ranksep=0.9, fontname="Helvetica", bgcolor="white"];
  node [shape=plaintext, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9, color="#555555", arrowhead=crow, arrowtail=tee, dir=both];
  labelloc="t"; fontsize=22; label="Guardian+ — Physical Schema ERD";
  subgraph cluster_0 {
    label="IAM"; fontsize=18; color="#bbbbbb"; style="rounded"; margin=18;
    "user_accounts" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#d9d9f5" ALIGN="LEFT"><B>user_accounts</B></TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">UQ</FONT></TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">email_verified</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">two_factor_enabled</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR></TABLE>>];
    "otp_codes" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#d9d9f5" ALIGN="LEFT"><B>otp_codes</B></TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">code_hash</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">purpose</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">expires_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">used_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR></TABLE>>];
    "password_reset_tokens" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#d9d9f5" ALIGN="LEFT"><B>password_reset_tokens</B></TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">token_hash</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">expires_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">used_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR></TABLE>>];
  }
  subgraph cluster_1 {
    label="PROFILE"; fontsize=18; color="#bbbbbb"; style="rounded"; margin=18;
    "user_profiles" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#d9d9f5" ALIGN="LEFT"><B>user_profiles</B></TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">first_name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">last_name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">phone_number</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">profile_image_url</TD><TD ALIGN="LEFT">TEXT</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR></TABLE>>];
    "care_recipient_profiles" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#d9d9f5" ALIGN="LEFT"><B>care_recipient_profiles</B></TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT">created_by_user_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">first_name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">last_name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">birth_date</TD><TD ALIGN="LEFT">DATE</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">profile_image_url</TD><TD ALIGN="LEFT">TEXT</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR></TABLE>>];
    "care_relationships" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#d9d9f5" ALIGN="LEFT"><B>care_relationships</B></TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT">care_recipient_profile_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">relationship_type</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">started_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">ended_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR></TABLE>>];
    "user_preferences" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#d9d9f5" ALIGN="LEFT"><B>user_preferences</B></TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">FK/UQ</FONT></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">language</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">notifications_enabled</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">high_contrast_enabled</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">voice_assistance_enabled</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">font_scale</TD><TD ALIGN="LEFT">DECIMAL(3,2)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR></TABLE>>];
  }
  subgraph cluster_2 {
    label="SUBSCRIPTIONS"; fontsize=18; color="#bbbbbb"; style="rounded"; margin=18;
    "subscription_plans" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#d9d9f5" ALIGN="LEFT"><B>subscription_plans</B></TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">UQ</FONT></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">TEXT</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">price</TD><TD ALIGN="LEFT">DECIMAL(10,2)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">currency</TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">billing_cycle</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">active</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR></TABLE>>];
    "subscriptions" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#d9d9f5" ALIGN="LEFT"><B>subscriptions</B></TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT">subscriber_user_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT">plan_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">current_period_start</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">current_period_end</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">cancel_at_period_end</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">cancelled_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR></TABLE>>];
    "payments" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#d9d9f5" ALIGN="LEFT"><B>payments</B></TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT">subscription_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">payment_type</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">amount</TD><TD ALIGN="LEFT">DECIMAL(10,2)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">currency</TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">provider</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">provider_reference</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">paid_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR></TABLE>>];
    "entitlements" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#d9d9f5" ALIGN="LEFT"><B>entitlements</B></TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">UQ</FONT></TD><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT">VARCHAR(80)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">TEXT</TD></TR></TABLE>>];
