  }
  subgraph cluster_3 {
    label="HEALTH MONITORING"; fontsize=18; color="#bbbbbb"; style="rounded"; margin=18;
    "wearable_devices" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#d9d9f5" ALIGN="LEFT"><B>wearable_devices</B></TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT">care_recipient_profile_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">UQ</FONT></TD><TD ALIGN="LEFT">serial_number</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">device_type</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">assigned_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR></TABLE>>];
    "vital_sign_types" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#d9d9f5" ALIGN="LEFT"><B>vital_sign_types</B></TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">UQ</FONT></TD><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">unit</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR></TABLE>>];
