digraph ERD {
  graph [rankdir=LR, splines=ortho, nodesep=0.45, ranksep=0.9, fontname="Helvetica", bgcolor="white"];
  node [shape=plaintext, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9, color="#555555", arrowhead=crow, arrowtail=tee, dir=both];
  subgraph cluster_0 {
    label="CARE ROUTINES &amp; WELLNESS"; fontsize=18; color="#bbbbbb"; style="rounded"; margin=18;
    "reminders" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#d9d9f5" ALIGN="LEFT"><B>reminders</B></TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT">person_under_care_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">type</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">scheduled_time</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">issued_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">reissue_count</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR></TABLE>>];
    "sleep_cycle_records" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#d9d9f5" ALIGN="LEFT"><B>sleep_cycle_records</B></TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT">person_under_care_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT">wearable_device_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">start_time</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">end_time</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">interruption_count</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">classification</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR></TABLE>>];
    "activity_monitors" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#d9d9f5" ALIGN="LEFT"><B>activity_monitors</B></TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">FK/UQ</FONT></TD><TD ALIGN="LEFT">person_under_care_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT">wearable_device_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">inactivity_since</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR></TABLE>>];
    "medication_stocks" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#d9d9f5" ALIGN="LEFT"><B>medication_stocks</B></TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">FK/UQ</FONT></TD><TD ALIGN="LEFT">person_under_care_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">remaining_doses</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">daily_consumption</TD><TD ALIGN="LEFT">DECIMAL(5,2)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">last_acquisition_date</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR></TABLE>>];
  }
  subgraph cluster_ext {
    label="Referencias externas"; fontsize=14; color="#dddddd"; style="dashed"; margin=14;
    "care_recipient_profiles" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#e6e6e6" ALIGN="LEFT"><B>care_recipient_profiles</B></TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT">created_by_user_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">first_name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">last_name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">birth_date</TD><TD ALIGN="LEFT">DATE</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">profile_image_url</TD><TD ALIGN="LEFT">TEXT</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR></TABLE>>];
    "wearable_devices" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#e6e6e6" ALIGN="LEFT"><B>wearable_devices</B></TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT">care_recipient_profile_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">UQ</FONT></TD><TD ALIGN="LEFT">serial_number</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">device_type</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">assigned_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR></TABLE>>];
  }
  "care_recipient_profiles" -> "wearable_devices" [headlabel="N", taillabel="1"];
  "care_recipient_profiles" -> "reminders" [headlabel="N", taillabel="1"];
  "care_recipient_profiles" -> "sleep_cycle_records" [headlabel="N", taillabel="1"];
  "wearable_devices" -> "sleep_cycle_records" [headlabel="N", taillabel="1"];
  "care_recipient_profiles" -> "activity_monitors" [headlabel="0..1", taillabel="1"];
  "wearable_devices" -> "activity_monitors" [headlabel="N", taillabel="1"];
  "care_recipient_profiles" -> "medication_stocks" [headlabel="0..1", taillabel="1"];
}
