digraph ERD {
  graph [rankdir=LR, splines=ortho, nodesep=0.45, ranksep=0.9, fontname="Helvetica", bgcolor="white"];
  node [shape=plaintext, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9, color="#555555", arrowhead=crow, arrowtail=tee, dir=both];
  subgraph cluster_0 {
    label="MOBILITY &amp; GEOFENCING"; fontsize=18; color="#bbbbbb"; style="rounded"; margin=18;
    "safe_zones" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#d9d9f5" ALIGN="LEFT"><B>safe_zones</B></TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT">fragile_citizen_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">latitude</TD><TD ALIGN="LEFT">DECIMAL(9,6)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">longitude</TD><TD ALIGN="LEFT">DECIMAL(9,6)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">radius_in_meters</TD><TD ALIGN="LEFT">DECIMAL(10,2)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR></TABLE>>];
    "location_trackings" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#d9d9f5" ALIGN="LEFT"><B>location_trackings</B></TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">FK/UQ</FONT></TD><TD ALIGN="LEFT">fragile_citizen_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">current_latitude</TD><TD ALIGN="LEFT">DECIMAL(9,6)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">current_longitude</TD><TD ALIGN="LEFT">DECIMAL(9,6)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">accuracy_in_meters</TD><TD ALIGN="LEFT">DECIMAL(6,2)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">current_status</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">last_updated_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR></TABLE>>];
    "location_records" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#d9d9f5" ALIGN="LEFT"><B>location_records</B></TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT">location_tracking_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT">wearable_device_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">latitude</TD><TD ALIGN="LEFT">DECIMAL(9,6)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">longitude</TD><TD ALIGN="LEFT">DECIMAL(9,6)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">accuracy_in_meters</TD><TD ALIGN="LEFT">DECIMAL(6,2)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">recorded_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR></TABLE>>];
    "zone_violations" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#d9d9f5" ALIGN="LEFT"><B>zone_violations</B></TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT">safe_zone_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT">fragile_citizen_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">latitude</TD><TD ALIGN="LEFT">DECIMAL(9,6)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">longitude</TD><TD ALIGN="LEFT">DECIMAL(9,6)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">detected_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR></TABLE>>];
  }
  subgraph cluster_ext {
    label="Referencias externas"; fontsize=14; color="#dddddd"; style="dashed"; margin=14;
    "care_recipient_profiles" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#e6e6e6" ALIGN="LEFT"><B>care_recipient_profiles</B></TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT">created_by_user_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">first_name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">last_name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">birth_date</TD><TD ALIGN="LEFT">DATE</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">profile_image_url</TD><TD ALIGN="LEFT">TEXT</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR></TABLE>>];
    "wearable_devices" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#e6e6e6" ALIGN="LEFT"><B>wearable_devices</B></TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT">care_recipient_profile_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">UQ</FONT></TD><TD ALIGN="LEFT">serial_number</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">device_type</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">assigned_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR></TABLE>>];
  }
  "care_recipient_profiles" -> "wearable_devices" [headlabel="N", taillabel="1"];
  "care_recipient_profiles" -> "safe_zones" [headlabel="N", taillabel="1"];
  "care_recipient_profiles" -> "location_trackings" [headlabel="0..1", taillabel="1"];
  "location_trackings" -> "location_records" [headlabel="N", taillabel="1"];
  "wearable_devices" -> "location_records" [headlabel="N", taillabel="1"];
  "safe_zones" -> "zone_violations" [headlabel="N", taillabel="1"];
  "care_recipient_profiles" -> "zone_violations" [headlabel="N", taillabel="1"];
}
