digraph ERD {
  graph [rankdir=LR, splines=ortho, nodesep=0.45, ranksep=0.9, fontname="Helvetica", bgcolor="white"];
  node [shape=plaintext, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9, color="#555555", arrowhead=crow, arrowtail=tee, dir=both];
  subgraph cluster_0 {
    label="EMERGENCY &amp; ALERTING"; fontsize=18; color="#bbbbbb"; style="rounded"; margin=18;
    "alerts" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#d9d9f5" ALIGN="LEFT"><B>alerts</B></TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT">care_recipient_profile_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">source_type</TD><TD ALIGN="LEFT">VARCHAR(40)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">source_reference_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">severity</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">triggered_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">confirmed_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">last_dispatched_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">acknowledged_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT">acknowledged_by_user_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">resolved_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">version</TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR></TABLE>>];
    "alert_deliveries" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#d9d9f5" ALIGN="LEFT"><B>alert_deliveries</B></TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT">alert_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">dispatch_order</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT">recipient_user_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">recipient_level</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">channel</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">delivery_status</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">sent_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">delivered_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR></TABLE>>];
    "alert_responses" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#d9d9f5" ALIGN="LEFT"><B>alert_responses</B></TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT">alert_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">claim_order</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT">responder_user_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">response_status</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">claimed_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">completed_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">notes</TD><TD ALIGN="LEFT">TEXT</TD></TR></TABLE>>];
    "incidents" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#d9d9f5" ALIGN="LEFT"><B>incidents</B></TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">FK/UQ</FONT></TD><TD ALIGN="LEFT">alert_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">marked_in_attention_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">stabilized_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">closed_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">notes</TD><TD ALIGN="LEFT">TEXT</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR></TABLE>>];
    "alert_settings" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#d9d9f5" ALIGN="LEFT"><B>alert_settings</B></TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">FK/UQ</FONT></TD><TD ALIGN="LEFT">care_recipient_profile_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">primary_ack_timeout_sec</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">escalation_enabled</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">silent_mode_enabled</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">broadcast_critical_immediately</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR></TABLE>>];
    "emergency_contacts" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#d9d9f5" ALIGN="LEFT"><B>emergency_contacts</B></TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT">care_recipient_profile_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">display_name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">relationship</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">phone_number</TD><TD ALIGN="LEFT">VARCHAR(16)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">priority_order</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">active</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR></TABLE>>];
    "alert_channel_settings" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#d9d9f5" ALIGN="LEFT"><B>alert_channel_settings</B></TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">channel</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">enabled</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">device_token</TD><TD ALIGN="LEFT">VARCHAR(512)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR></TABLE>>];
  }
  subgraph cluster_ext {
    label="Referencias externas"; fontsize=14; color="#dddddd"; style="dashed"; margin=14;
    "user_accounts" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#e6e6e6" ALIGN="LEFT"><B>user_accounts</B></TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">UQ</FONT></TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">email_verified</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">two_factor_enabled</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR></TABLE>>];
    "care_recipient_profiles" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#e6e6e6" ALIGN="LEFT"><B>care_recipient_profiles</B></TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT">created_by_user_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">first_name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">last_name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">birth_date</TD><TD ALIGN="LEFT">DATE</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">profile_image_url</TD><TD ALIGN="LEFT">TEXT</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="RIGHT"><FONT POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR></TABLE>>];
  }
  "user_accounts" -> "care_recipient_profiles" [headlabel="N", taillabel="1"];
  "care_recipient_profiles" -> "alerts" [headlabel="N", taillabel="1"];
  "user_accounts" -> "alerts" [headlabel="N", taillabel="1"];
  "alerts" -> "alert_deliveries" [headlabel="N", taillabel="1"];
  "user_accounts" -> "alert_deliveries" [headlabel="N", taillabel="1"];
  "alerts" -> "alert_responses" [headlabel="N", taillabel="1"];
  "user_accounts" -> "alert_responses" [headlabel="N", taillabel="1"];
  "alerts" -> "incidents" [headlabel="0..1", taillabel="1"];
  "care_recipient_profiles" -> "alert_settings" [headlabel="0..1", taillabel="1"];
  "care_recipient_profiles" -> "emergency_contacts" [headlabel="N", taillabel="1"];
  "user_accounts" -> "emergency_contacts" [headlabel="N", taillabel="1"];
  "user_accounts" -> "alert_channel_settings" [headlabel="N", taillabel="1"];
}
