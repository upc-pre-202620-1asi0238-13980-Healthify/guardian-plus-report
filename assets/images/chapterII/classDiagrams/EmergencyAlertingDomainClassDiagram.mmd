---
config:
  theme: neutral
  layout: elk
---
classDiagram
    direction TB

    class Alert {
        -AlertId id
        -CareRecipientProfileId careRecipientProfileId
        -AlertSource source
        -Severity severity
        -AlertStatus status
        -List~AlertDelivery~ deliveries
        -List~AlertResponse~ responses
        -Instant triggeredAt
        -Instant confirmedAt
        -Instant lastDispatchedAt
        -Instant acknowledgedAt
        -UserId acknowledgedByUserId
        -Instant resolvedAt
        +confirm(Instant) void
        +dismissAsFalsePositive(Instant) void
        +dispatch(RecipientLevel, List~DeliveryTarget~, Instant) List~AlertDelivery~
        +escalate(List~DeliveryTarget~, Instant) List~AlertDelivery~
        +broadcast(List~DeliveryTarget~, Instant) List~AlertDelivery~
        +registerDeliveryResult(AlertDeliveryId, DeliveryStatus, Instant) void
        +acknowledge(UserId, Instant) void
        +claimResponse(UserId, Instant) AlertResponse
        +completeResponse(AlertResponseId, String, Instant) void
        +resolve(Instant) void
        +currentRecipientLevel() RecipientLevel
        +isAwaitingAcknowledgement() boolean
        +isAckTimeoutExpired(AckTimeout, Instant) boolean
        +isConfirmationWindowExpired(Instant) boolean
    }

    class AlertDelivery {
        -AlertDeliveryId id
        -UserId recipientUserId
        -RecipientLevel recipientLevel
        -NotificationChannel channel
        -DeliveryStatus deliveryStatus
        -Instant sentAt
        -Instant deliveredAt
        +markAsSent(Instant sentAt) void
        +markAsDelivered(Instant deliveredAt) void
        +markAsFailed() void
    }

    class AlertResponse {
        -AlertResponseId id
        -UserId responderUserId
        -ResponseStatus responseStatus
        -Instant claimedAt
        -Instant completedAt
        -String notes
        +complete(String notes, Instant) void
        +cancel() void
    }

    class Incident {
        -IncidentId id
        -AlertId alertId
        -IncidentStatus status
        -Instant markedInAttentionAt
        -Instant stabilizedAt
        -Instant closedAt
        -String notes
        +stabilize(String notes, Instant) void
        +close(String notes, Instant) void
        +isClosed() boolean
    }

    class AlertSettings {
        -AlertSettingsId id
        -CareRecipientProfileId careRecipientProfileId
        -AckTimeout primaryAckTimeout
        -boolean escalationEnabled
        -boolean silentModeEnabled
        -boolean broadcastCriticalImmediately
        +update(AckTimeout, Boolean, Boolean) void
        +activateSilentMode() void
        +deactivateSilentMode() void
        +allowsAudibleNotificationFor(Severity severity) boolean
    }

    class EmergencyContact {
        -EmergencyContactId id
        -CareRecipientProfileId careRecipientProfileId
        -UserId userId
        -String displayName
        -String relationship
        -PhoneNumber phoneNumber
        -PriorityOrder priorityOrder
        -boolean active
        +updateContactDetails(String, String, PhoneNumber) void
        +changePriority(PriorityOrder priorityOrder) void
        +activate() void
        +deactivate() void
        +isPrimary() boolean
    }

    class AlertChannelSetting {
        -AlertChannelSettingId id
        -UserId userId
        -NotificationChannel channel
        -boolean enabled
        -String deviceToken
        +enable() void
        +disable() void
        +registerDeviceToken(String) void
    }

    class AlertSource {
        -AlertSourceType sourceType
        -UUID sourceReferenceId
        +requiresConfirmationWindow() boolean
    }

    class AckTimeout {
        -Integer seconds
        +hasExpired(Instant since, Instant now) boolean
    }

    class FallConfirmationWindow {
        -Duration DURATION = 20 s
        +hasExpired(Instant triggeredAt, Instant now) boolean
    }

    class PhoneNumber {
        -String value
    }

    class DeliveryTarget {
        -UserId recipientUserId
        -NotificationChannel channel
    }

    class PriorityOrder {
        -Integer value
        +isPrimary() boolean
    }

    class DispatchStrategyPolicy {
        <<domain service>>
        +resolveInitialLevel(Severity, AlertSettings) RecipientLevel
    }

    class EscalationPolicy {
        <<domain service>>
        +resolveNextLevel(Alert, AlertSettings, List~EmergencyContact~) Optional~RecipientLevel~
        +resolveRecipients(RecipientLevel, Severity, List~EmergencyContact~, List~AlertChannelSetting~) List~DeliveryTarget~
    }

    class AlertSourceType {
        <<enumeration>>
        FALL_DETECTED
        SOS_TRIGGERED
        VITAL_SIGN_ANOMALY
        SAFE_ZONE_VIOLATION
        PROLONGED_INACTIVITY
        REMINDER_REISSUED
        MEDICATION_RESTOCK_SUGGESTED
        +defaultSeverity() Severity
        +isWearableReported() boolean
    }

    class Severity {
        <<enumeration>>
        CRITICAL
        HIGH
        MEDIUM
        +allowsImmediateBroadcast() boolean
        +allowsEscalation() boolean
        +overridesSilentMode() boolean
        +requiresSmsBackup() boolean
    }

    class AlertStatus {
        <<enumeration>>
        PENDING_CONFIRMATION
        TRIGGERED
        ESCALATED
        ACKNOWLEDGED
        DISMISSED
        RESOLVED
        +canTransitionTo(AlertStatus target) boolean
    }

    class IncidentStatus {
        <<enumeration>>
        IN_ATTENTION
        STABILIZED
        CLOSED
    }

    class RecipientLevel {
        <<enumeration>>
        PRIMARY
        SECONDARY
        BROADCAST
        +next() RecipientLevel
    }

    class NotificationChannel {
        <<enumeration>>
        PUSH
        SMS
        IN_APP
    }

    class DeliveryStatus {
        <<enumeration>>
        PENDING
        SENT
        DELIVERED
        FAILED
    }

    class ResponseStatus {
        <<enumeration>>
        CLAIMED
        COMPLETED
        CANCELLED
    }

    Alert "1" *-- "0..*" AlertDelivery : entrega
    Alert "1" *-- "0..*" AlertResponse : registra
    Alert *-- AlertSource
    Alert *-- Severity
    Alert *-- AlertStatus
    AlertSource *-- AlertSourceType
    AlertDelivery *-- RecipientLevel
    AlertDelivery *-- NotificationChannel
    AlertDelivery *-- DeliveryStatus
    AlertResponse *-- ResponseStatus

    Incident "0..1" --> "1" Alert : atiende (AlertId)
    Incident *-- IncidentStatus

    AlertSettings *-- AckTimeout
    EmergencyContact *-- PriorityOrder
    EmergencyContact *-- PhoneNumber
    AlertChannelSetting *-- NotificationChannel

    DispatchStrategyPolicy ..> AlertSettings : consulta
    DispatchStrategyPolicy ..> Severity : evalúa
    EscalationPolicy ..> EmergencyContact : ordena por prioridad
    EscalationPolicy ..> AlertChannelSetting : resuelve canales
    EscalationPolicy ..> DeliveryTarget : produce
    Alert ..> DeliveryTarget : recibe
    Alert ..> AckTimeout : evalúa vencimiento
    Alert ..> FallConfirmationWindow : evalúa vencimiento
